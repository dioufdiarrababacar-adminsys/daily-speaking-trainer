# Variables lues par server.js. `npm start` charge ./.env s'il existe, sinon le .env du workspace Jarvis (../../../.env).
# Dépôt autonome : copie ce fichier en .env et remplis la clé.
# Clé gratuite : aistudio.google.com → Get API key. GOOGLE_API_KEY est acceptée en repli.
GEMINI_API_KEY=
# Optionnel
PORT=3000
DST_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
